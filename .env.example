# Set a random long secret. Endpoints are local-only by default.
DASHBOARD_TOKEN=replace-with-random-long-secret
DB_PATH=/data/radar.db
CONFIG_DIR=/app/config
LOG_LEVEL=INFO

# Alpaca market-data credentials (NEVER share these). Empty => skip live news.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_NEWS_URL=wss://stream.data.alpaca.markets/v1beta1/news

# Longbridge - optional; see README for authentication (requires your own credentials).
LB_ENABLED=false
LB_NEWS_ENABLED=false
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_CLIENT_ID=
LONGBRIDGE_ENABLE_OVERNIGHT=true

# Initial AI configuration; Settings page saves overrides in data/settings.json.
# Providers: openai (Responses), gemini (generateContent), anthropic (Messages), compatible.
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# With no explicit AI_ENABLED, an initial API key enables AI.
# AI_ENABLED=true
AI_MAX_REQUESTS_PER_HOUR=60
AI_TIMEOUT_SECONDS=45
MARKET_PROVIDER=yahoo
# ALPACA_NEWS_ENABLED=true

# Push channels, all optional. One or both can be enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BARK_KEY=
BARK_BASE_URL=https://api.day.app
NOTIFICATIONS_ENABLED=true

# SEC user-agent must contain an identifiable contact before SEC is enabled.
SEC_CONTACT=  # example: MarketRadar you@example.com
RSS_INTERVAL_SECONDS=90
LB_NEWS_INTERVAL_SECONDS=120
NEWS_MAX_AGE_MINUTES=25
TEST_MODE=false

# X 用户言论监控（账号在设置页管理；API 读取可能计费）
X_ENABLED=false
X_BEARER_TOKEN=
X_POLL_INTERVAL_SECONDS=120
LONGBRIDGE_ENABLE_OVERNIGHT=true
